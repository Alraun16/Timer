<Window x:Class="Timer.ControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timer"
        Width="450"
        SizeToContent="Height"
        MaxHeight="1000"
        MinHeight="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Grid x:Name="RootGrid"
          Background="{StaticResource AppBackgroundBrush}"
          Focusable="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= TITLE BAR ================= -->
        <Grid Grid.Row="0"
              Background="Transparent"
              Margin="10,8,10,0"
              MouseDown="TitleBar_MouseDown">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">

                    <Button x:Name="ToggleOverlayButton"
                            Style="{StaticResource WindowButton}"
                            Margin="0,0,8,0"
                            Click="ToggleOverlayButton_Click"
                            ToolTip="Оверлей">
                        <Grid Width="19" Height="19">
                            <Viewbox x:Name="ShowOverlayIcon">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M2.2 12C4.6 8.55 8.02 6.5 12 6.5C15.98 6.5 19.4 8.55 21.8 12C19.4 15.45 15.98 17.5 12 17.5C8.02 17.5 4.6 15.45 2.2 12Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                    <Ellipse Canvas.Left="8.85"
                                             Canvas.Top="8.85"
                                             Width="6.3"
                                             Height="6.3"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                             StrokeThickness="1.4"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox x:Name="HideOverlayIcon" Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M2.2 12C4.6 8.55 8.02 6.5 12 6.5C15.98 6.5 19.4 8.55 21.8 12C19.4 15.45 15.98 17.5 12 17.5C8.02 17.5 4.6 15.45 2.2 12Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"/>
                                    <Ellipse Canvas.Left="8.85"
                                             Canvas.Top="8.85"
                                             Width="6.3"
                                             Height="6.3"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                             StrokeThickness="1.4"/>
                                    <Path Data="M4 20L20 4"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource WindowButton}"
                            Margin="0,0,8,0"
                            Click="Minimize_Click">
                        <Grid Width="22" Height="22">
                            <Path Data="M4 11H18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="3.2"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource WindowButton}"
                            Click="Close_Click">
                        <Grid Width="22" Height="22">
                            <Path Data="M5 5L17 17"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="3.2"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"/>
                            <Path Data="M17 5L5 17"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="3.2"
                                  StrokeStartLineCap="Square"
                                  StrokeEndLineCap="Square"/>
                        </Grid>
                    </Button>

                </StackPanel>

            </Grid>

        <!-- ================= TIMER ================= -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="26,18"
                Width="360"
                HorizontalAlignment="Center"
                Effect="{StaticResource PanelShadowEffect}"
                Margin="0,10,0,12">

            <Grid Height="92">

                <TextBlock x:Name="TimeDisplay"
                           Text="00:05:00"
                           FontSize="50"
                           FontFamily="Segoe UI Light"
                           FontWeight="Normal"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <Grid x:Name="DurationPanel"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="82"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="CountdownHours"
                             Grid.Column="0"
                             Text="0"
                             Style="{StaticResource DurationTextBox}"
                             GotFocus="TimeBox_GotFocus"
                             PreviewMouseLeftButtonDown="TimeBox_PreviewMouseLeftButtonDown"
                             PreviewTextInput="DurationTextBox_PreviewTextInput"
                             TextChanged="CountdownDuration_TextChanged"
                             LostKeyboardFocus="CountdownDuration_LostFocus"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="ЧАСЫ"
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"/>

                    <TextBlock Grid.Column="1"
                               Text=":"
                               FontSize="34"
                               FontFamily="Segoe UI Light"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,6,0,0"/>

                    <TextBox x:Name="CountdownMinutes"
                             Grid.Column="2"
                             Text="60"
                             Style="{StaticResource DurationTextBox}"
                             GotFocus="TimeBox_GotFocus"
                             PreviewMouseLeftButtonDown="TimeBox_PreviewMouseLeftButtonDown"
                             PreviewTextInput="DurationTextBox_PreviewTextInput"
                             TextChanged="CountdownDuration_TextChanged"
                             LostKeyboardFocus="CountdownDuration_LostFocus"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Text="МИНУТЫ"
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"/>

                    <TextBlock Grid.Column="3"
                               Text=":"
                               FontSize="34"
                               FontFamily="Segoe UI Light"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,6,0,0"/>

                    <TextBox x:Name="CountdownSeconds"
                             Grid.Column="4"
                             Text="00"
                             Style="{StaticResource DurationTextBox}"
                             GotFocus="TimeBox_GotFocus"
                             PreviewMouseLeftButtonDown="TimeBox_PreviewMouseLeftButtonDown"
                             PreviewTextInput="DurationTextBox_PreviewTextInput"
                             TextChanged="CountdownDuration_TextChanged"
                             LostKeyboardFocus="CountdownDuration_LostFocus"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="4"
                               Text="СЕКУНДЫ"
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"/>

                </Grid>

            </Grid>
        </Border>

        <!-- ================= CONTROLS ================= -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14">

            <Button x:Name="ResetButton"
                    Style="{StaticResource DangerIconButton}"
                    Click="ResetButton_Click"
                    Margin="0,0,18,0"/>

            <Button x:Name="EditButton"
                    Style="{StaticResource IconButton}"
                    Click="EditButton_Click"
                    Margin="0,0,18,0"
                    ToolTip="Edit"/>

            <Button x:Name="PlayPauseButton"
                    Style="{StaticResource PrimaryIconButton}"
                    Click="PlayPauseButton_Click"
                    Margin="0,0,18,0"/>

            <Button x:Name="FinishButton"
                    Style="{StaticResource IconButton}"
                    Click="FinishButton_Click"/>

        </StackPanel>

        <!-- ================= EDIT ================= -->
        <Border x:Name="EditPanel"
                Grid.Row="3"
                Visibility="Collapsed"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Effect="{StaticResource PanelShadowEffect}"
                Margin="16,0,16,12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Текущая задача"
                           FontSize="18"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Margin="0,0,0,10"/>

                <Grid Grid.Row="1">
                    <TextBox x:Name="TaskDescriptionTextBox"
                             Style="{StaticResource DescriptionTextBox}"
                             MaxLength="1000"/>

                    <TextBlock x:Name="TaskDescriptionPlaceholder"
                               Text="Краткое описание задачи..."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="18"
                               Margin="14,9,0,0"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="CancelTaskDescriptionButton"
                                Content="Отмена"
                                Style="{StaticResource TextButton}"
                                MinWidth="96"
                                Margin="0,0,14,0"
                                Click="CancelTaskDescriptionButton_Click"/>

                        <Button x:Name="SaveTaskDescriptionButton"
                                Content="Сохранить"
                                Style="{StaticResource TextButton}"
                                MinWidth="112"
                                Click="SaveTaskDescriptionButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TaskDescriptionCounter"
                               Grid.Column="2"
                               Text="0 / 120"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= SETTINGS BUTTONS ================= -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,16,12">

            <Button x:Name="HistoryButton"
                    Style="{StaticResource IconButton}"
                    Click="HistoryButton_Click"
                    Margin="0,0,8,0"/>

            <Button x:Name="SettingsButton"
                    Style="{StaticResource IconButton}"
                    Click="SettingsButton_Click"/>

        </StackPanel>

        <!-- ================= SETTINGS / HISTORY ================= -->
        <Grid Grid.Row="5">

            <!-- SETTINGS -->
            <Border x:Name="SettingsPanel"
                    Visibility="Collapsed"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Effect="{StaticResource PanelShadowEffect}"
                    Margin="16,0,16,12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Screen" Foreground="#C7C5C2" Margin="0,0,12,10"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ScreenSelector" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Position" Foreground="#C7C5C2" Margin="0,0,12,10"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="PositionSelector" Margin="0,0,0,10">
                        <ComboBoxItem Content="Top Left"/>
                        <ComboBoxItem Content="Top Center" IsSelected="True"/>
                        <ComboBoxItem Content="Top Right"/>
                        <ComboBoxItem Content="Bottom Left"/>
                        <ComboBoxItem Content="Bottom Center"/>
                        <ComboBoxItem Content="Bottom Right"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="BG" Foreground="#C7C5C2" Margin="0,0,12,10"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Slider x:Name="BackgroundOpacitySlider"
                            Width="220"
                            Minimum="0"
                            Maximum="100"
                            Value="50"
                            ValueChanged="BackgroundOpacitySlider_ValueChanged"/>
                        <TextBlock x:Name="BackgroundOpacityLabel"
                                   Text="0%"
                                   Foreground="#C7C5C2"
                                   Width="42"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Play/Pause" Foreground="#C7C5C2" Margin="0,0,12,10"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="PlayHotkeyModifierSelector" Width="100" Margin="0,0,10,0"/>
                        <ComboBox x:Name="PlayHotkeyKeySelector" Width="100"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Overlay" Foreground="#C7C5C2" Margin="0,0,12,12"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <ComboBox x:Name="OverlayHotkeyModifierSelector" Width="100" Margin="0,0,10,0"/>
                        <ComboBox x:Name="OverlayHotkeyKeySelector" Width="100"/>
                    </StackPanel>

                    <Grid Grid.Row="5" Grid.ColumnSpan="2">
                        <Button Grid.Row="5"
                            Grid.Column="1"
                            x:Name="SaveSettingsButton"
                            Content="Сохранить"
                            Style="{StaticResource TextButton}"
                            MinWidth="112"
                            HorizontalAlignment="Center"
                            Click="SaveSettingsButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- HISTORY -->
            <Border x:Name="HistoryPanel"
                    Visibility="Collapsed"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    MaxHeight="640"
                    Effect="{StaticResource PanelShadowEffect}"
                    Margin="16,0,16,12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="История"
                                   FontSize="18"
                                   FontWeight="Normal"
                                   Foreground="#C7C5C2"/>

                        <TextBlock x:Name="HistoryTotalTextBlock"
                                   Grid.Column="1"
                                   Text="Всего: 0 мин"
                                   FontSize="18"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Style="{StaticResource HistoryScrollViewer}"
                                  MaxHeight="570"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HistoryStack"/>
                    </ScrollViewer>
                </Grid>

            </Border>

        </Grid>

    </Grid>
</Window>
