<Window x:Class="Timer.ControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Timer"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Grid Margin="14" Background="{StaticResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- TITLE BAR -->
            <RowDefinition Height="Auto"/>
            <!-- TIMER -->
            <RowDefinition Height="Auto"/>
            <!-- CONTROLS -->
            <RowDefinition Height="Auto"/>
            <!-- EDIT -->
            <RowDefinition Height="Auto"/>
            <!-- SETTINGS BUTTONS -->
            <RowDefinition Height="Auto"/>
            <!-- SETTINGS/HISTORY -->
        </Grid.RowDefinitions>

        <!-- ================= TITLE BAR ================= -->
        <Border Grid.Row="0"
                Background="{StaticResource AppBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0"
                CornerRadius="8"
                Padding="10,6"
                MouseDown="TitleBar_MouseDown">

            <Grid Height="28">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="ToggleOverlayButton"
                            Width="30"
                            Height="22"
                            Margin="0,0,6,0"
                            Click="ToggleOverlayButton_Click"
                            ToolTip="Оверлей">
                        <Image Source="pack://application:,,,/Icons/icon-overlay.png"
                               Width="16"
                               Height="16"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    </Button>

                    <Button Content="—"
                            Width="30"
                            Height="22"
                            Margin="0,0,6,0"
                            Click="Minimize_Click"/>
                    <Button Content="✕"
                            Width="30"
                            Height="22"
                            Click="Close_Click"/>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ================= TIMER ================= -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,10">

            <Grid Height="54">

                <TextBlock x:Name="TimeDisplay"
                           Text="00:05:00"
                           FontSize="34"
                           FontFamily="Courier New"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <StackPanel x:Name="DurationPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBox x:Name="CountdownHours"
                             Text="0"
                             Style="{StaticResource DurationTextBox}"
                             GotFocus="TimeBox_GotFocus"
                             PreviewMouseLeftButtonDown="TimeBox_PreviewMouseLeftButtonDown"
                             PreviewTextInput="DurationTextBox_PreviewTextInput"
                             TextChanged="CountdownDuration_TextChanged"
                             LostFocus="CountdownDuration_LostFocus"/>

                    <TextBlock Text=":" FontSize="35" VerticalAlignment="Center" Margin="4,-10,4,0"/>

                    <TextBox x:Name="CountdownMinutes"
                             Text="60"
                             Style="{StaticResource DurationTextBox}"
                             GotFocus="TimeBox_GotFocus"
                             PreviewMouseLeftButtonDown="TimeBox_PreviewMouseLeftButtonDown"
                             PreviewTextInput="DurationTextBox_PreviewTextInput"
                             TextChanged="CountdownDuration_TextChanged"
                             LostFocus="CountdownDuration_LostFocus"/>

                    <TextBlock Text=":" FontSize="35" VerticalAlignment="Center" Margin="4,-10,4,0"/>

                    <TextBox x:Name="CountdownSeconds"
                             Text="00"
                             Style="{StaticResource DurationTextBox}"
                             GotFocus="TimeBox_GotFocus"
                             PreviewMouseLeftButtonDown="TimeBox_PreviewMouseLeftButtonDown"
                             PreviewTextInput="DurationTextBox_PreviewTextInput"
                             TextChanged="CountdownDuration_TextChanged"
                             LostFocus="CountdownDuration_LostFocus"/>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ================= CONTROLS ================= -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8">

            <Button x:Name="ResetButton"
                    Style="{StaticResource DangerIconButton}"
                    Click="ResetButton_Click"
                    Margin="0,0,8,0">
                <Image Source="pack://application:,,,/Icons/icon-reset.png"
                       Width="38"
                       Height="38"/>
            </Button>

            <Button x:Name="EditButton"
                    Style="{StaticResource IconButton}"
                    Click="EditButton_Click"
                    Margin="0,0,8,0"
                    ToolTip="Edit">
                <Viewbox Width="38" Height="38">
                    <Grid Width="1024" Height="1024">
                        <Path Fill="#D9D9D9"
                              Data="M761.1 288.3L687.8 215 325.1 577.6l-15.6 89 88.9-15.7z"/>
                        <Path Fill="#D9D9D9"
                              Data="M880 836H144c-17.7 0-32 14.3-32 32v36c0 4.4 3.6 8 8 8h784c4.4 0 8-3.6 8-8v-36c0-17.7-14.3-32-32-32zm-622.3-84c2 0 4-.2 6-.5L431.9 722c2-.4 3.9-1.3 5.3-2.8l423.9-423.9a9.96 9.96 0 0 0 0-14.1L694.9 114.9c-1.9-1.9-4.4-2.9-7.1-2.9s-5.2 1-7.1 2.9L256.8 538.8c-1.5 1.5-2.4 3.3-2.8 5.3l-29.5 168.2a33.5 33.5 0 0 0 9.4 29.8c6.6 6.4 14.9 9.9 23.8 9.9zm67.4-174.4L687.8 215l73.3 73.3-362.7 362.6-88.9 15.7 15.6-89z"/>
                    </Grid>
                </Viewbox>
            </Button>

            <Button x:Name="PlayPauseButton"
                    Style="{StaticResource PrimaryIconButton}"
                    Click="PlayPauseButton_Click"
                    Margin="0,0,8,0">
                <Image x:Name="PlayPauseIcon"
                       Source="pack://application:,,,/Icons/icon-play.png"
                       Width="38"
                       Height="38"/>
            </Button>

            <Button x:Name="FinishButton"
                    Style="{StaticResource IconButton}"
                    Click="FinishButton_Click">
                <Image Source="pack://application:,,,/Icons/icon-finish.png"
                       Width="38"
                       Height="38"/>
            </Button>

        </StackPanel>

        <!-- ================= EDIT ================= -->
        <Border x:Name="EditPanel"
                Grid.Row="3"
                Visibility="Collapsed"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBox x:Name="TaskDescriptionTextBox"
                             Style="{StaticResource DescriptionTextBox}"
                             MaxLength="1000"/>

                    <TextBlock x:Name="TaskDescriptionPlaceholder"
                               Text="Краткое описание задачи..."
                               Foreground="{StaticResource MutedTextBrush}"
                               Opacity="0.65"
                               Margin="11,8,0,0"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="CancelTaskDescriptionButton"
                                Content="Отмена"
                                Style="{StaticResource TextButton}"
                                MinWidth="86"
                                Margin="0,0,8,0"
                                Click="CancelTaskDescriptionButton_Click"/>

                        <Button x:Name="SaveTaskDescriptionButton"
                                Content="Сохранить"
                                Style="{StaticResource TextButton}"
                                MinWidth="86"
                                Click="SaveTaskDescriptionButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TaskDescriptionCounter"
                               Grid.Column="2"
                               Text="0 / 120"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= SETTINGS BUTTONS ================= -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,4">

            <Button x:Name="HistoryButton"
                    Style="{StaticResource IconButton}"
                    Click="HistoryButton_Click"
                    Margin="0,0,2,0">
                <Image Source="pack://application:,,,/Icons/icon-history.png"
                       Width="34"
                       Height="34"/>
            </Button>

            <Button x:Name="SettingsButton"
                    Style="{StaticResource IconButton}"
                    Click="SettingsButton_Click">
                <Image Source="pack://application:,,,/Icons/icon-settings.png"
                       Width="34"
                       Height="34"/>
            </Button>

        </StackPanel>

        <!-- ================= SETTINGS / HISTORY ================= -->
        <Grid Grid.Row="5">

            <!-- SETTINGS -->
            <Border x:Name="SettingsPanel"
                    Visibility="Collapsed"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,4,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Screen" Margin="0,0,12,8"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ScreenSelector" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Position" Margin="0,0,12,8"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="PositionSelector" Margin="0,0,0,8">
                        <ComboBoxItem Content="Top Left"/>
                        <ComboBoxItem Content="Top Center" IsSelected="True"/>
                        <ComboBoxItem Content="Top Right"/>
                        <ComboBoxItem Content="Bottom Left"/>
                        <ComboBoxItem Content="Bottom Center"/>
                        <ComboBoxItem Content="Bottom Right"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="BG" Margin="0,0,12,10"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Slider x:Name="BackgroundOpacitySlider"
                            Width="190"
                            Minimum="0"
                            Maximum="100"
                            Value="50"
                            ValueChanged="BackgroundOpacitySlider_ValueChanged"/>
                        <TextBlock x:Name="BackgroundOpacityLabel"
                                   Text="0%"
                                   Width="40"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Play/Pause" Margin="0,0,12,8"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="PlayHotkeyModifierSelector" Width="86" Margin="0,0,8,0"/>
                        <ComboBox x:Name="PlayHotkeyKeySelector" Width="86"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Overlay" Margin="0,0,12,12"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <ComboBox x:Name="OverlayHotkeyModifierSelector" Width="86" Margin="0,0,8,0"/>
                        <ComboBox x:Name="OverlayHotkeyKeySelector" Width="86"/>
                    </StackPanel>

                    <Grid Grid.Row="5" Grid.ColumnSpan="2">
                        <Button Grid.Row="5"
                            Grid.Column="1"
                            x:Name="SaveSettingsButton"
                            Content="Сохранить"
                            Style="{StaticResource TextButton}"
                            MinWidth="80"
                            HorizontalAlignment="Center"
                            Click="SaveSettingsButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- HISTORY -->
            <Border x:Name="HistoryPanel"
                    Visibility="Collapsed"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,4,0,0">

                <ScrollViewer MaxHeight="250"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HistoryStack"/>
                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>
</Window>
